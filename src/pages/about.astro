---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import FaqList from "../components/FaqList.astro";
import Cta from "../components/Cta.astro";
import { faqs } from "../data/faq";
import { leadership, collaborators, specialties, collaboration } from "../data/team";
import { site } from "../config/site";
import { url } from "../utils/url";

const principles = [
  {
    title: "Evidence over opinion",
    text: "Every claim about a system gets a test.",
  },
  {
    title: "Simple first",
    text: "The smallest useful system beats the impressive one.",
  },
  {
    title: "Built to be owned",
    text: "If a team cannot run it, it is not finished.",
  },
];
---

<BaseLayout
  title="About"
  description="ACE Labs is an independent technology and product innovation lab, founded by Prasad F. and built with a small group of collaborators."
>
  <PageHead
    tag="About"
    title="We build and modernize the systems work runs on."
    lead={site.description}
  />

  <section>
    <div class="wrap about-copy">
      <span class="tag">What we do</span>
      <h2>AI, Cloud & Engineering, together.</h2>
      <p>
        Most real problems need all three disciplines: data and models that work, infrastructure
        that stays up, and software that people can maintain. ACE Labs brings them together on one
        system instead of treating them as separate projects.
      </p>
      <p>
        We work on QMS, ERP, SaaS and healthcare systems, plus the AI, cloud and data work around
        them. For anything the lab builds, the aim is a system that other people can read, run and
        own, with the documentation and tests that make that possible.
      </p>
      <p>
        The lab is also built in the open. Open source and community are at its core, and the work
        is shared as <a href={url("open-source/")}>code</a> and <a href={url("notes/")}>notes</a>.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">The details</span>
      <h2>At a glance.</h2>
      <dl class="details">
        <div><dt>Name</dt><dd>{site.name}</dd></div>
        <div><dt>Stands for</dt><dd>{site.expansion}</dd></div>
        <div><dt>Led by</dt><dd>Prasad aka Ace, CEO &amp; Co-Founder</dd></div>
        <div><dt>Status</dt><dd>Independent side project</dd></div>
        <div><dt>Open source</dt><dd><a href={site.links.github} rel="noopener">github.com/acelabs-hq/acelabs</a></dd></div>
        <div><dt>Contact</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
      </dl>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">Independence</span>
      <h2>A side project, on its own footing.</h2>
      <p class="lead">{site.independence}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">Principles</span>
      <h2>How the lab thinks.</h2>
      <div class="grid">
        {
          principles.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">Who runs ACE Labs</span>
      <h2>Leadership.</h2>
      <div class="grid">
        {
          leadership.map((person) => (
            <div class="card person">
              <div class="avatar" aria-hidden="true">{person.initials}</div>
              <h3>{person.name}</h3>
              <p><b>{person.role}.</b> {person.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="collaborators">
    <div class="wrap">
      <span class="tag">The bench</span>
      <h2>When we need more firepower, we collaborate.</h2>
      <p class="lead">
        Some problems need more hands or deeper specialties. The lab brings in trusted engineers and
        domain experts as collaborators. They work with us, not for us: they join as partners on the
        project, share the goals and the standards, and are credited for what they build.
      </p>
      <div class="grid">
        {
          collaborators.map((person) => (
            <div class="card person">
              <div class="avatar" aria-hidden="true">{person.initials}</div>
              <h3>{person.name}</h3>
              <p><b>{person.role}.</b> {person.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div>
        <span class="tag">Specialties</span>
        <h2>Covered together.</h2>
        <div class="grid single">
          {
            specialties.map((item) => (
              <div class="card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <span class="tag">How collaboration works</span>
        <h2>One lead, one standard.</h2>
        <ul class="list">
          {collaboration.map((step) => <li>{step}</li>)}
        </ul>
        <p>
          Independent engineer or specialist? Tell us what you do best and how you like to work.
        </p>
        <a class="btn ghost" href={url("contact/")}>Get in touch</a>
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <span class="tag">FAQ</span>
      <h2>Questions people ask.</h2>
      <FaqList items={faqs} />
    </div>
  </section>

  <Cta />
</BaseLayout>
