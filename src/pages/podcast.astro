---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import Cta from "../components/Cta.astro";
import { podcastTopics } from "../data/focus";
---

<BaseLayout
  title="Podcast"
  description="A podcast from ACE Labs with researchers, engineers, explorers and builders about AI, sustainable systems and the culture of building."
>
  <PageHead
    tag="Podcast"
    title="A podcast for researchers and builders."
    lead="Conversations with researchers, engineers, explorers and builders about what they are working on, and how it holds up in practice. It is part of the same practice as the research and the products."
  />

  <section>
    <div class="wrap">
      <span class="tag">What it covers</span>
      <h2>Five themes.</h2>
      <div class="grid">
        {
          podcastTopics.map((topic) => (
            <div class="card">
              <h3>{topic.title}</h3>
              <p>{topic.text}</p>
            </div>
          ))
        }
      </div>
      <p class="note-banner">
        The podcast is in the works. There are no episodes yet, and this page will link to them
        once they exist.
      </p>
    </div>
  </section>

  <Cta title="Want to be a guest, or suggest a topic?" text="Tell us who you are and what you build, or what you would like us to talk about." />
</BaseLayout>
