---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NetworkCanvas from "../components/NetworkCanvas.astro";
import FaqList from "../components/FaqList.astro";
import Cta from "../components/Cta.astro";
import RobotScene from "../components/RobotScene.astro";
import { services, engagement } from "../data/services";
import { faqs } from "../data/faq";
import { site } from "../config/site";
import { url } from "../utils/url";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <NetworkCanvas />
    <div class="wrap hero-inner">
      <div>
        <span class="tag">Independent AI research & product lab</span>
        <h1>We build and modernize <em>the systems work runs on.</em></h1>
        <p class="lead">
          {site.name} is an independent side project exploring applied AI, cloud and software
          engineering, with a focus on clear systems that a team can read, run and own.
        </p>
        <div class="actions">
          <a class="btn" href={url("contact/")}>Get in touch</a>
          <a class="btn ghost" href={url("open-source/")}>Open source</a>
        </div>
      </div>
      <div>
        <RobotScene />
        <div class="pillars">
        <div><b>A: AI</b>Applied AI that solves a real problem and is tested against real failures.</div>
        <div><b>C: Cloud</b>Reliable, secure, cost-aware infrastructure that scales and recovers.</div>
        <div><b>E: Engineering</b>Clean software and automation that a team can own.</div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">The problem</span>
      <h2>Real systems break at the edges.</h2>
      <p class="lead">
        Most businesses do not lack ideas. They lack software that matches how the work actually
        happens.
      </p>
      <div class="grid">
        <div class="card">
          <h3>Knowledge lives in people</h3>
          <p>
            Procedures, approvals and exceptions are held in spreadsheets, emails and one person's
            memory.
          </p>
        </div>
        <div class="card">
          <h3>Tools don't talk</h3>
          <p>
            Quality, finance, inventory and customer data sit in separate places, reconciled by
            hand.
          </p>
        </div>
        <div class="card">
          <h3>AI stays a pilot</h3>
          <p>
            Demos impress, but without data, evaluation and integration they never reach daily use.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div>
        <span class="tag">Another way</span>
        <h2>It doesn't have to be this hard.</h2>
        <p class="lead">
          Imagine a new workflow that goes live quickly, audits and reports that come straight from
          the system, and AI doing the repetitive reading and sorting while people make the
          decisions.
        </p>
      </div>
      <div>
        <span class="tag">The approach</span>
        <ul class="list">
          <li>
            <b>Map the process first.</b> Learn how the work really runs before designing anything.
          </li>
          <li>
            <b>Build the smallest useful system.</b> Ship it early and test it with real users.
          </li>
          <li>
            <b>Hand it over properly.</b> Documentation, evaluations and a team that can run it.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">Services</span>
      <h2>Bring the hard part.</h2>
      <div class="grid">
        {
          services.map((service, index) => (
            <div class="card">
              <span class="tag">{String(index + 1).padStart(2, "0")}</span>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
            </div>
          ))
        }
      </div>
      <p class="actions mt">
        <a class="btn ghost" href={url("services/")}>Explore services</a>
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">How an engagement works</span>
      <h2>Start small, scale when it works.</h2>
      <div class="grid">
        {
          engagement.map((step) => (
            <div class="card">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div>
        <span class="tag">A practice led by Prasad F.</span>
        <h2>The lab, and the work behind it.</h2>
        <p class="lead">
          ACE Labs is a practice, not just a company page. Alongside the research and the products,
          Prasad shares his day-to-day routine as content: what he is building, learning and
          testing, including what does not work.
        </p>
      </div>
      <div>
        <span class="tag">Research & podcast</span>
        <ul class="list">
          <li><b>Research.</b> Applied AI, system sustainability and builder culture, explored in the open. <a href={url("research/")}>See the research →</a></li>
          <li><b>Podcast.</b> An indie hacking podcast, in the works. <a href={url("podcast/")}>About the podcast →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div>
        <span class="tag">Open source</span>
        <h2>Built in the open.</h2>
        <p class="lead">
          The lab works in the open where it can. This site and its code are public on GitHub, and
          open source work will be listed here as it happens.
        </p>
      </div>
      <div>
        <p class="actions">
          <a class="btn ghost" href={site.links.github} rel="noopener">See the code on GitHub</a>
        </p>
        <p class="note-banner no-top">
          The lab holds no certifications, memberships or partner status yet, and this site does
          not claim any.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">Follow along</span>
      <h2>Join the conversation.</h2>
      <p class="lead">Follow the lab on Instagram, X and Discord as they go live.</p>
      <p class="actions">
        <a class="btn" href={site.links.instagram} rel="noopener">Instagram @ace_labs_in</a>
        {site.links.x && <a class="btn ghost" href={site.links.x} rel="noopener">X</a>}
        {site.links.discord && <a class="btn ghost" href={site.links.discord} rel="noopener">Discord</a>}
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">Notes</span>
      <h2>Thinking out loud.</h2>
      <div>
        {
          notes.map((note) => (
            <a class="post-link" href={url(`notes/${note.id}/`)}>
              <h3>{note.data.title}</h3>
              <p>{note.data.description}</p>
            </a>
          ))
        }
      </div>
      <p class="mt"><a href={url("notes/")}>All notes →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="tag">FAQ</span>
      <h2>Common questions.</h2>
      <FaqList items={faqs.slice(0, 4)} />
      <p class="mt"><a href={url("about/#faq")}>More questions →</a></p>
    </div>
  </section>

  <Cta />
</BaseLayout>
