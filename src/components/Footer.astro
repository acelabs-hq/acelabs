---
import { site } from "../config/site";
import { icons } from "../config/icons";
import { url } from "../utils/url";

const year = new Date().getFullYear();

/**
 * Icon-only social links. Accounts without a link yet show a dimmed icon and become
 * links once the URL is filled in (src/config/site.ts).
 */
const socials = [
  { label: "Instagram", href: site.links.instagram, icon: icons.instagram },
  { label: "LinkedIn", href: site.links.linkedin, icon: icons.linkedin, always: true },
  { label: "X", href: site.links.x, icon: icons.x, always: true },
  { label: "YouTube", href: site.links.youtube, icon: icons.youtube, always: true },
  { label: "Discord", href: site.links.discord, icon: icons.discord, always: true },
  { label: "GitHub", href: site.links.github, icon: icons.github },
].filter((item) => item.href || item.always);

const columns = [
  {
    title: "Lab",
    links: [
      { label: "Research", href: "research/" },
      { label: "Podcast", href: "podcast/" },
      { label: "Notes", href: "notes/" },
      { label: "Open source", href: "open-source/" },
    ],
  },
  {
    title: "Work",
    links: [
      { label: "Services", href: "services/" },
      { label: "Systems", href: "systems/" },
      { label: "Projects", href: "projects/" },
    ],
  },
  {
    title: "ACE Labs",
    links: [
      { label: "About", href: "about/" },
      { label: "Contact", href: "contact/" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={url()} aria-label={site.name}>
          <img class="brand-logo" src={url("logo.svg")} alt="" width="40" height="40" />
        </a>
        <b>{site.name}</b>
        <p>{site.tagline}</p>
        <p class="footer-social">
          {
            socials.map((item) =>
              item.href ? (
                <a class="social-icon" href={item.href} rel="noopener" aria-label={item.label} title={item.label}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon} /></svg>
                </a>
              ) : (
                <span class="social-icon" role="img" aria-label={`${item.label} (coming soon)`} title={`${item.label}: coming soon`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon} /></svg>
                </span>
              )
            )
          }
        </p>
      </div>
      {
        columns.map((column) => (
          <div class="footer-col">
            <b>{column.title}</b>
            {column.links.map((link) => <a href={url(link.href)}>{link.label}</a>)}
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <span>
        © {year} {site.name}, {site.expansion} · An independent side project ·
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </span>
    </div>
  </div>
</footer>
