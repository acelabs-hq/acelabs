---
import { site } from "../config/site";
import { url } from "../utils/url";

const year = new Date().getFullYear();

/**
 * Icon-only social links. X is hidden until it has a link. Discord always shows its
 * icon, and becomes a link once site.links.discord is filled in (src/config/site.ts).
 */
const icons = {
  instagram:
    "M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6Zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z",
  x: "M18.9 2H22l-7.2 8.2L23.3 22h-6.6l-5.2-6.8L5.5 22H2.4l7.7-8.8L2 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.7L7.4 3.9H5.6L17.7 20Z",
  discord:
    "M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.2.5a18 18 0 0 0-4.4 0L10.6 3a19.7 19.7 0 0 0-4.9 1.4C2.6 9 1.8 13.5 2.2 18a19.9 19.9 0 0 0 6 3l.9-1.5a12.9 12.9 0 0 1-1.4-.7l.3-.3a14.2 14.2 0 0 0 12 0l.3.3c-.4.3-.9.5-1.4.7l.9 1.5a19.8 19.8 0 0 0 6-3c.5-5.2-.8-9.7-3.5-13.6ZM8.7 15.3c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2Zm6.6 0c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2Z",
  github:
    "M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A10 10 0 0 0 12 2Z",
};

const socials = [
  { label: "Instagram", href: site.links.instagram, icon: icons.instagram },
  { label: "X", href: site.links.x, icon: icons.x },
  { label: "Discord", href: site.links.discord, icon: icons.discord, always: true },
  { label: "GitHub", href: site.links.github, icon: icons.github },
].filter((item) => item.href || item.always);

const columns = [
  {
    title: "Lab",
    links: [
      { label: "Research", href: "research/" },
      { label: "Podcast", href: "podcast/" },
      { label: "Notes", href: "notes/" },
    ],
  },
  {
    title: "Work",
    links: [
      { label: "Services", href: "services/" },
      { label: "Systems", href: "systems/" },
      { label: "Projects", href: "projects/" },
    ],
  },
  {
    title: "ACE Labs",
    links: [
      { label: "About", href: "about/" },
      { label: "Contact", href: "contact/" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={url()} aria-label={site.name}>
          <img class="brand-logo" src={url("logo.svg")} alt="" width="40" height="40" />
        </a>
        <b>{site.name}</b>
        <p>{site.tagline}</p>
        <p class="footer-social">
          {
            socials.map((item) =>
              item.href ? (
                <a class="social-icon" href={item.href} rel="noopener" aria-label={item.label} title={item.label}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon} /></svg>
                </a>
              ) : (
                <span class="social-icon" role="img" aria-label={`${item.label} (coming soon)`} title={`${item.label}: coming soon`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.icon} /></svg>
                </span>
              )
            )
          }
        </p>
      </div>
      {
        columns.map((column) => (
          <div class="footer-col">
            <b>{column.title}</b>
            {column.links.map((link) => <a href={url(link.href)}>{link.label}</a>)}
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <span>
        © {year} {site.name}, {site.expansion} · An independent side project ·
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </span>
    </div>
  </div>
</footer>
